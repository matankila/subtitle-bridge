# Node API: copy to .env; never commit real credentials.
HOST=127.0.0.1
PORT=8787
PUBLIC_ORIGIN=http://127.0.0.1:8787
SQLITE_PATH=./data/subtitle-bridge.sqlite
REQUEST_HISTORY_OWNER_EMAIL=owner@localhost
ADMIN_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
GOOGLE_TRANSLATE_ENABLED=true
GEMINI_REFINEMENT_ENABLED=false
# Enable after configuring a model/API project with sufficient quota:
# GEMINI_API_KEY=REPLACE_WITH_YOUR_OWN_KEY
# GEMINI_REFINEMENT_MODEL=gemini-3.5-flash-lite
TRANSLATION_MONTHLY_CHAR_LIMIT=5000000
# LIBRETRANSLATE_URL=https://your-translator.example
# LIBRETRANSLATE_API_KEY=REPLACE_WITH_YOUR_OWN_KEY
# DEEPL_API_KEY=REPLACE_WITH_YOUR_OWN_KEY
